ENVIRONMENT='local'
LOG_LEVEL='INFO'

# Chave da API do provider do modelo (por padrão, a OpenAI). No workshop, ela já
# vem preenchida no .env compartilhado no Drive da turma; fora dele, use a sua.
MODEL_API_KEY='changethis'
# Modelo padrão usado por todos os agentes que não escolhem um próprio.
# Vazio usa o default do código (gpt-6-luna).
MODEL=''
# Modelo de embeddings, usado pelos evals de similaridade de cossenos.
# Vazio usa o default do código (text-embedding-3-small).
MODEL_EMBEDDING_MODEL=''
# Endpoint compatível com Chat Completions. Vazio usa a OpenAI; para outro
# provider, aponte para ele e troque MODEL e MODEL_API_KEY junto, por exemplo:
#   DeepSeek: https://api.deepseek.com
#   Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_BASE_URL=''
# Esforço de raciocínio. O padrão 'none' é obrigatório pro gpt-6-luna aceitar
# tools e temperatura no Chat Completions. Deixe vazio pra providers que não
# conhecem o parâmetro (DeepSeek, por exemplo).
MODEL_REASONING_EFFORT='none'
# Teto de segurança de tokens (entrada + saída, sub-agentes inclusos) por turno,
# cerca de 2x um turno normal de planejamento (~42 mil). Protege a cota
# compartilhada do workshop de um agente em loop: ao atingir o teto, o turno é
# interrompido. Vazio usa o default do código (85000); 0 desliga o limite.
MODEL_TOKEN_BUDGET_PER_TURN=''

# Qualquer valor não vazio desliga as cores do terminal (https://no-color.org).
NO_COLOR=''

# Caminho do banco SQLite local. `make reset-db` recria e popula este arquivo.
DATABASE_PATH='data/planner.db'

# Deixe vazio. `make run-case-tool-error` preenche com o nome de uma tool, que
# passa a falhar em toda chamada pra mostrar um span de erro no Langfuse.
FORCE_TOOL_ERROR=''
# Deixe vazio. `make run-case-slow-tool` preenche com o nome de uma tool, que
# passa a demorar 5s a mais em toda chamada pra aparecer na timeline do Langfuse.
FORCE_SLOW_TOOL=''

# Langfuse Cloud: cada aluno usa a própria conta (plano Hobby, gratuito).
# Vazio em qualquer uma das chaves, o chat roda sem tracing e avisa ao abrir.
LANGFUSE_TRACING_ENABLED=true
# Região EU do Langfuse Cloud. Fixo, não precisa mexer.
LANGFUSE_BASE_URL='https://cloud.langfuse.com'
# Preencha com as suas chaves: em https://cloud.langfuse.com, abra o seu projeto
# > Settings > API Keys > Create new API keys. A secret key só aparece uma vez,
# então copie as duas antes de fechar a janela.
LANGFUSE_PUBLIC_KEY=''
LANGFUSE_SECRET_KEY=''
