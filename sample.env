ENVIRONMENT='local'
LOG_LEVEL='INFO'

# Chave da API do Modelo
MODEL_API_KEY='changethis'
# Modelo padrão usado por todos os agentes que não escolhem um próprio.
MODEL=''
# Modelo de embeddings, usado pelos evals de similaridade de cossenos.
MODEL_EMBEDDING_MODEL=''

# Caminho do banco SQLite local. `make reset-db` recria e popula este arquivo.
DATABASE_PATH='data/planner.db'

# Langfuse local (`make run-langfuse`). As chaves abaixo já vêm provisionadas
# pelo docker-compose.yml, então funcionam sem passar pela interface.
LANGFUSE_TRACING_ENABLED=true
# Porta da interface do Langfuse. Se a 3000 estiver ocupada, troque as duas linhas.
LANGFUSE_PORT=3000
LANGFUSE_BASE_URL='http://localhost:3000'
LANGFUSE_PUBLIC_KEY='pk-lf-workshop'
LANGFUSE_SECRET_KEY='sk-lf-workshop'
